---
import Layout from '../layouts/Layout.astro';
import { desc, eq } from 'drizzle-orm';
import { getDb } from '../lib/db';
import { properties } from '../lib/schema';

let featuredHomes: (typeof properties.$inferSelect)[] = [];
let listingsAvailable = true;
try { featuredHomes = await getDb().select().from(properties).where(eq(properties.published, true)).orderBy(desc(properties.featured), desc(properties.createdAt)).limit(3); }
catch { listingsAvailable = false; }
const money = (amount: number, currency: string) => new Intl.NumberFormat('en', { style: 'currency', currency, maximumFractionDigits: 0 }).format(amount);
---

<Layout>
	<header class="site-header">
		<div class="wrap header-inner">
			<a class="wordmark" href="/" aria-label="Estate and Estate home">
				<span class="brand-mark" aria-hidden="true">E<span style="color:#c3ab80">&</span>E</span>
				<span>ESTATE &amp; ESTATE</span>
			</a>
			<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
			<nav class="main-nav" aria-label="Main navigation">
				<a href="/properties">Properties</a>
				<a href="/#approach">Our approach</a>
				<a href="/#about">About</a>
				<a class="nav-cta" href="/contact">Let’s talk <span aria-hidden="true">↗</span></a>
			</nav>
		</div>
	</header>

	<main>
		<section class="hero" aria-labelledby="hero-title">
			<img class="hero-image" src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=2200&q=88" alt="Sunlit contemporary home opening onto a quiet garden" fetchpriority="high" />
			<div class="wrap hero-content">
				<div class="eyebrow hero-kicker">A more considered way home</div>
				<h1 class="serif" id="hero-title">Find your<br />sense of place.</h1>
				<p class="hero-copy">The right home is more than an address. It is where your next chapter begins, and we are here to help you find it.</p>
				<div class="hero-actions">
					<a class="button button-light" href="/properties">Explore properties <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="/contact">Speak with our team</a>
				</div>
			</div>
			<span class="hero-caption">Architectural photography · illustrative imagery</span>
		</section>

		<section class="wrap intro" id="about">
			<div class="intro-label eyebrow">Estate &amp; Estate — Real estate, thoughtfully done</div>
			<div>
				<h2 class="serif">A good move starts with listening.</h2>
				<p class="intro-copy">Choosing a home is personal. We take the time to understand what matters to you, offer clear advice at every step, and help make the decisions ahead feel a little simpler.</p>
				<a class="intro-link" href="/contact">Get to know us <span aria-hidden="true">⟶</span></a>
			</div>
		</section>

		<section class="feature-band" aria-labelledby="feature-title">
			<div class="feature-photo">
				<img src="https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1400&q=85" alt="A calm, light-filled interior with natural materials" loading="lazy" />
			</div>
			<div class="feature-copy">
				<span class="eyebrow">People first, always</span>
				<h2 class="serif" id="feature-title">Good guidance makes all the difference.</h2>
				<p>From the first conversation to the final details, you will have a thoughtful partner beside you. No pressure, just honest answers and considered support.</p>
				<a class="button" href="/contact">How we can help <span aria-hidden="true">↗</span></a>
			</div>
		</section>

		<section class="wrap listings" id="properties">
			<div class="section-heading">
				<div><span class="eyebrow">The right place is out there</span><h2 class="serif">Find a home<br />that feels like yours.</h2></div>
				<p>Explore the homes currently represented by our team. Every listing is shared with care and up-to-date details.</p>
			</div>
			{featuredHomes.length ? <div class="property-grid">{featuredHomes.map((home) => <a class="property-card" href={`/properties/${home.slug}`}>
				{home.imageUrl ? <img src={home.imageUrl} alt={home.imageAlt || home.title} loading="lazy" /> : <div class="property-image-empty" aria-label="No property image available"><span>Estate &amp; Estate</span></div>}
				<h3 class="serif">{home.title}</h3><p>{[home.area, home.city].filter(Boolean).join(', ')}</p><p class="price">{money(home.price, home.currency)}</p>
			</a>)}</div> : <div class="listing-note">
				<div>
					<span class="eyebrow">{listingsAvailable ? 'Our property collection' : 'Property collection'}</span>
					<h3 class="serif">{listingsAvailable ? 'Your next chapter starts with a conversation.' : 'Our property collection is temporarily unavailable.'}</h3>
					<p>{listingsAvailable ? 'There are no published properties to show right now. Tell us what you are looking for and our team will be glad to help.' : 'Please try again shortly, or contact our team and we will be glad to help.'}</p>
					<a href="/contact">Tell us what you have in mind <span aria-hidden="true">&nbsp;↗</span></a>
				</div>
			</div>}
		</section>

		<section class="approach" id="approach">
			<div class="wrap">
				<div class="approach-top">
					<div><span class="eyebrow">Clear from the start</span><h2 class="serif">A thoughtful process.<br />A better move.</h2></div>
					<p>Buying or selling should feel considered, never overwhelming. We bring local insight and steady support to each decision.</p>
				</div>
				<div class="steps">
					<article class="step"><span class="step-num">01</span><h3>Start with a conversation</h3><p>We listen first, so we understand your priorities, timing and the details that matter most.</p></article>
					<article class="step"><span class="step-num">02</span><h3>Make a considered plan</h3><p>Get straightforward guidance and a clear view of the steps ahead, tailored to your goals.</p></article>
					<article class="step"><span class="step-num">03</span><h3>Move with confidence</h3><p>We stay alongside you through the details, helping your next move come together smoothly.</p></article>
				</div>
			</div>
		</section>

		<section class="contact-band" id="contact">
			<div class="wrap contact-inner">
				<span class="eyebrow">Whenever you are ready</span>
				<h2 class="serif">Let’s find your next place.</h2>
				<a class="button" href="/contact">Start a conversation <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="wrap">
			<div class="footer-top">
				<a class="wordmark" href="/" aria-label="Estate and Estate home"><span class="brand-mark">E<span style="color:#c3ab80">&</span>E</span><span>ESTATE &amp; ESTATE</span></a>
				<nav class="footer-nav" aria-label="Footer navigation"><a href="/properties">Properties</a><a href="/#approach">Our approach</a><a href="/contact">Contact</a><a href="/admin">Staff access</a></nav>
			</div>
			<div class="footer-bottom"><span>© {new Date().getFullYear()} Estate &amp; Estate. All rights reserved.</span><span>Thoughtful moves begin here.</span></div>
		</div>
	</footer>
	<script>
		const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
		const nav = document.querySelector<HTMLElement>('.main-nav');
		toggle?.addEventListener('click', () => {
			const open = toggle.getAttribute('aria-expanded') !== 'true';
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			nav?.classList.toggle('open', open);
		});
	</script>
</Layout>
