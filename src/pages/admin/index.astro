---
import { desc, eq } from 'drizzle-orm';
import { z } from 'zod';
import Layout from '../../layouts/Layout.astro';
import { checkStaffCredentials, clearStaffCookie, createStaffCookie, hasStaffSession, isSameOrigin, secureCookie, staffCredentialsConfigured } from '../../lib/auth';
import { getDb } from '../../lib/db';
import { inquiries, properties } from '../../lib/schema';

export const prerender = false;
let loggedIn = await hasStaffSession(Astro.request);
let error = '';
const configured = staffCredentialsConfigured();

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const action = String(form.get('action') ?? '');
	if (!isSameOrigin(Astro.request, Astro.url.origin)) error = 'This request could not be verified. Please reload and try again.';
	else if (action === 'login') {
		if (await checkStaffCredentials(String(form.get('email') ?? ''), String(form.get('password') ?? ''))) {
			return new Response(null, { status: 303, headers: { Location: '/admin', 'Set-Cookie': await createStaffCookie(secureCookie(Astro.request, Astro.url)) } });
		}
		error = 'The email or password is incorrect.';
	} else if (action === 'logout') {
		return new Response(null, { status: 303, headers: { Location: '/admin', 'Set-Cookie': clearStaffCookie(secureCookie(Astro.request, Astro.url)) } });
	} else if (!loggedIn) {
		error = 'Please sign in to continue.';
	} else if (action === 'delete' || action === 'publish' || action === 'unpublish') {
		const id = z.uuid().safeParse(form.get('id'));
		if (!id.success) error = 'The selected property could not be found.';
		else try {
			const db = getDb();
			if (action === 'delete') await db.delete(properties).where(eq(properties.id, id.data));
			else await db.update(properties).set({ published: action === 'publish', updatedAt: new Date() }).where(eq(properties.id, id.data));
			return Astro.redirect('/admin?saved=1', 303);
		} catch { error = 'The change could not be saved. Please try again.'; }
	} else if (action === 'create') {
		const schema = z.object({
			title: z.string().trim().min(5).max(180), description: z.string().trim().min(20).max(5000), city: z.string().trim().min(2).max(100),
			area: z.string().trim().max(120).optional(), price: z.coerce.number().int().positive(), currency: z.string().regex(/^[A-Z]{3}$/),
			bedrooms: z.preprocess((v) => v === '' || v == null ? undefined : Number(v), z.number().int().min(0).max(50).optional()),
			bathrooms: z.preprocess((v) => v === '' || v == null ? undefined : Number(v), z.number().int().min(0).max(50).optional()),
			sizeSqft: z.preprocess((v) => v === '' || v == null ? undefined : Number(v), z.number().int().positive().optional()),
			imageUrl: z.union([z.literal(''), z.url()]).optional(), imageAlt: z.string().trim().max(240).optional(),
		});
		const parsed = schema.safeParse(Object.fromEntries(form.entries()));
		if (!parsed.success) error = 'Please complete the required fields with valid details.';
		else {
			const slug = parsed.data.title.toLowerCase().normalize('NFKD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 160);
			try {
				await getDb().insert(properties).values({ ...parsed.data, area: parsed.data.area || null, imageUrl: parsed.data.imageUrl || null, imageAlt: parsed.data.imageAlt || null, bedrooms: parsed.data.bedrooms ?? null, bathrooms: parsed.data.bathrooms ?? null, sizeSqft: parsed.data.sizeSqft ?? null, slug, featured: false, published: false });
				return Astro.redirect('/admin?saved=1', 303);
			} catch { error = 'This property could not be created. Check that its title is unique and try again.'; }
		}
	}
	loggedIn = await hasStaffSession(Astro.request);
}

let allProperties: (typeof properties.$inferSelect)[] = [];
let recentInquiries: (typeof inquiries.$inferSelect)[] = [];
let dbReady = true;
if (loggedIn) try {
	const db = getDb();
	[allProperties, recentInquiries] = await Promise.all([
		db.select().from(properties).orderBy(desc(properties.updatedAt)),
		db.select().from(inquiries).orderBy(desc(inquiries.createdAt)).limit(50),
	]);
} catch { dbReady = false; }
const saved = Astro.url.searchParams.get('saved') === '1';
const money = (amount: number, currency: string) => new Intl.NumberFormat('en', { style: 'currency', currency, maximumFractionDigits: 0 }).format(amount);
---

<Layout title="Staff | Estate & Estate" description="Private property management for Estate & Estate staff.">
	<main>
		<section class="page-hero"><div class="wrap"><a href="/" class="wordmark" style="display:inline-flex;margin-bottom:42px"><span class="brand-mark">E<span style="color:#c3ab80">&</span>E</span><span>ESTATE &amp; ESTATE</span></a><br /><span class="eyebrow">Private staff area</span><h1 class="serif">{loggedIn ? 'Property management' : 'Staff access'}</h1><p>{loggedIn ? 'Manage the properties represented by your team.' : 'Sign in to manage Estate & Estate property listings.'}</p></div></section>
		<section class="content-area"><div class="wrap">
			{!configured && <div class="notice">Staff sign-in is not configured. Add STAFF_EMAIL, STAFF_PASSWORD and a long random SESSION_SECRET to the server environment to enable this area.</div>}
			{error && <div class="notice error" role="alert">{error}</div>}{saved && <div class="notice" role="status">Your changes have been saved.</div>}
			{!loggedIn ? <form class="form-shell" method="post" style="max-width:440px">
				<input type="hidden" name="action" value="login" />
				<div class="field"><label for="email">Staff email</label><input id="email" type="email" name="email" autocomplete="username" required /></div>
				<div class="field"><label for="password">Password</label><input id="password" type="password" name="password" autocomplete="current-password" required /></div>
				<button class="button" type="submit" disabled={!configured}>Sign in</button>
			</form> : <>
				<div style="display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:35px"><h2 class="serif" style="font-size:36px;margin:0">Your properties <span style="font:12px 'DM Sans';color:var(--stone)">({allProperties.length})</span></h2><form method="post"><input type="hidden" name="action" value="logout" /><button class="button" type="submit">Sign out</button></form></div>
				{!dbReady ? <div class="notice">The database is not ready. Apply the migration in <code>drizzle/0001_estate_schema.sql</code> and confirm DATABASE_URL is configured.</div> : <>
					{allProperties.map((home) => <article style="display:flex;align-items:center;justify-content:space-between;gap:20px;padding:17px 0;border-bottom:1px solid var(--line)">
						<div><strong>{home.title}</strong><div style="margin-top:5px;color:var(--stone);font-size:12px">{home.city} · {money(home.price, home.currency)} · {home.published ? 'Published' : 'Draft'}</div></div>
						<div style="display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end"><a class="button" href={`/admin/${home.id}`} style="min-height:38px">Edit</a><form method="post"><input type="hidden" name="id" value={home.id} /><input type="hidden" name="action" value={home.published ? 'unpublish' : 'publish'} /><button class="button" style="min-height:38px" type="submit">{home.published ? 'Unpublish' : 'Publish'}</button></form><form method="post" onsubmit="return confirm('Delete this property? This cannot be undone.')"><input type="hidden" name="id" value={home.id} /><input type="hidden" name="action" value="delete" /><button class="button" style="min-height:38px;background:#7a3c32" type="submit">Delete</button></form></div>
					</article>)}
					<h2 class="serif" style="font-size:36px;margin:65px 0 25px">Add a property</h2>
					<form class="form-shell" method="post"><input type="hidden" name="action" value="create" />
						<div class="form-grid"><div class="field"><label for="title">Property title *</label><input id="title" name="title" required minlength="5" maxlength="180" /></div><div class="field"><label for="city">City *</label><input id="city" name="city" required maxlength="100" /></div></div>
						<div class="field"><label for="area">Neighbourhood / area</label><input id="area" name="area" maxlength="120" /></div>
						<div class="field"><label for="description">Description *</label><textarea id="description" name="description" required minlength="20" maxlength="5000"></textarea></div>
						<div class="form-grid"><div class="field"><label for="price">Price *</label><input id="price" name="price" type="number" min="1" step="1" required /></div><div class="field"><label for="currency">Currency code *</label><input id="currency" name="currency" placeholder="e.g. PKR" pattern="[A-Z]{3}" maxlength="3" required /></div></div>
						<div class="form-grid"><div class="field"><label for="bedrooms">Bedrooms</label><input id="bedrooms" name="bedrooms" type="number" min="0" max="50" /></div><div class="field"><label for="bathrooms">Bathrooms</label><input id="bathrooms" name="bathrooms" type="number" min="0" max="50" /></div></div>
						<div class="form-grid"><div class="field"><label for="sizeSqft">Interior size (sq ft)</label><input id="sizeSqft" name="sizeSqft" type="number" min="1" /></div><div class="field"><label for="imageUrl">Image URL</label><input id="imageUrl" name="imageUrl" type="url" placeholder="https://…" /></div></div>
						<div class="field"><label for="propertyImage">Upload image <span style="font-weight:400;color:var(--stone)">(Cloudinary credentials required)</span></label><input id="propertyImage" type="file" accept="image/*" data-cloudinary-input /><button class="button" type="button" data-cloudinary-upload style="align-self:flex-start">Upload image</button><small data-cloudinary-status aria-live="polite"></small></div>
						<div class="field"><label for="imageAlt">Image description</label><input id="imageAlt" name="imageAlt" maxlength="240" /></div>
						<button class="button" type="submit">Save as draft <span aria-hidden="true">↗</span></button>
					</form>
					<h2 class="serif" style="font-size:36px;margin:65px 0 25px">Recent inquiries <span style="font:12px 'DM Sans';color:var(--stone)">(latest 50)</span></h2>
					{recentInquiries.length ? <div>{recentInquiries.map((inquiry) => <article style="padding:20px 0;border-bottom:1px solid var(--line)">
						<div style="display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap"><strong>{inquiry.name}</strong><time style="color:var(--stone);font-size:11px">{inquiry.createdAt.toLocaleString()}</time></div>
						<p style="margin:8px 0;color:var(--stone);font-size:12px"><a href={`mailto:${inquiry.email}`}>{inquiry.email}</a>{inquiry.phone && <> · <a href={`tel:${inquiry.phone.replace(/[^+\d]/g, '')}`}>{inquiry.phone}</a></>}{inquiry.propertyId && <> · Property ref: {inquiry.propertyId}</>}</p>
						<p style="max-width:800px;margin:0;white-space:pre-wrap;font-size:13px;line-height:1.7">{inquiry.message}</p>
					</article>)}</div> : <p style="color:var(--stone);font-size:13px">No inquiries yet.</p>}
				</>}
			</>}
		</div></section>
	</main>
	<script>
		const uploadButton = document.querySelector<HTMLButtonElement>('[data-cloudinary-upload]');
		const fileInput = document.querySelector<HTMLInputElement>('[data-cloudinary-input]');
		const imageUrlInput = document.querySelector<HTMLInputElement>('#imageUrl');
		const uploadStatus = document.querySelector<HTMLElement>('[data-cloudinary-status]');
		uploadButton?.addEventListener('click', async () => {
			const file = fileInput?.files?.[0];
			if (!file) { if (uploadStatus) uploadStatus.textContent = 'Choose an image first.'; return; }
			uploadButton.disabled = true;
			if (uploadStatus) uploadStatus.textContent = 'Uploading…';
			try {
				const body = new FormData(); body.set('file', file);
				const response = await fetch('/api/admin/upload', { method: 'POST', body });
				const result = await response.json() as { url?: string; error?: string };
				if (!response.ok || !result.url) throw new Error(result.error || 'Upload failed.');
				if (imageUrlInput) imageUrlInput.value = result.url;
				if (uploadStatus) uploadStatus.textContent = 'Image uploaded and added to the image URL field.';
			} catch (err) { if (uploadStatus) uploadStatus.textContent = err instanceof Error ? err.message : 'Upload failed.'; }
			finally { uploadButton.disabled = false; }
		});
	</script>
	<footer class="site-footer"><div class="wrap footer-bottom"><a href="/">Estate &amp; Estate</a><span>Private staff access</span><a href="/properties">Public properties</a></div></footer>
</Layout>
