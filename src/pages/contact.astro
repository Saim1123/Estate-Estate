---
import { and, eq } from 'drizzle-orm';
import { z } from 'zod';
import Layout from '../layouts/Layout.astro';
import { businessDetails } from '../lib/business';
import { getDb } from '../lib/db';
import { inquiries, properties } from '../lib/schema';

const queryProperty = Astro.url.searchParams.get('property') ?? '';
let selectedProperty: { id: string; title: string } | undefined;
if (queryProperty) {
	try { [selectedProperty] = await getDb().select({ id: properties.id, title: properties.title }).from(properties).where(and(eq(properties.id, queryProperty), eq(properties.published, true))).limit(1); } catch { /* The form remains available if the collection is offline. */ }
}
let sent = Astro.url.searchParams.get('sent') === '1';
let error = '';
if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	if (String(form.get('website') ?? '').trim()) return Astro.redirect('/contact?sent=1');
	const parsed = z.object({
		name: z.string().trim().min(2).max(160),
		email: z.email().max(254),
		phone: z.string().trim().max(40).optional(),
		message: z.string().trim().min(10).max(4000),
		propertyId: z.uuid().optional(),
	}).safeParse({
		name: form.get('name'), email: form.get('email'), phone: form.get('phone') || undefined,
		message: form.get('message'), propertyId: form.get('propertyId') || undefined,
	});
	if (!parsed.success) error = 'Please check your details and make sure your message is at least 10 characters.';
	else {
		try {
			const propertyId = parsed.data.propertyId && selectedProperty?.id === parsed.data.propertyId ? parsed.data.propertyId : null;
			await getDb().insert(inquiries).values({ ...parsed.data, propertyId });
			return Astro.redirect('/contact?sent=1', 303);
		} catch {
			error = 'We could not send your message just now. Please try again shortly.';
		}
	}
}
---

<Layout title="Contact | Estate & Estate" description="Tell Estate & Estate what you are looking for. Our team will be in touch.">
	<header class="site-header" style="position:absolute"><div class="wrap header-inner">
		<a class="wordmark" href="/"><span class="brand-mark">E<span style="color:#c3ab80">&</span>E</span><span>ESTATE &amp; ESTATE</span></a>
		<button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false">☰</button>
		<nav class="main-nav" aria-label="Main navigation"><a href="/properties">Properties</a><a href="/#approach">Our approach</a><a href="/contact">Contact</a><a class="nav-cta" href="/contact">Let’s talk ↗</a></nav>
	</div></header>
	<main>
		<section class="page-hero"><div class="wrap"><span class="eyebrow">We are here to listen</span><h1 class="serif">Let’s talk.</h1><p>Tell us a little about what you are looking for. A member of our team will be in touch.</p></div></section>
		<section class="content-area"><div class="wrap">
			{sent ? <div class="notice" role="status">Thank you for reaching out. Your message has been received.</div> : <>
				{error && <div class="notice error" role="alert">{error}</div>}
				<div class="contact-layout"><form class="form-shell" method="post">
					{selectedProperty && <div class="notice">Enquiry about: {selectedProperty.title}<input type="hidden" name="propertyId" value={selectedProperty.id} /></div>}
					<div class="form-grid">
						<div class="field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required minlength="2" maxlength="160" /></div>
						<div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" /></div>
					</div>
					<div class="field"><label for="phone">Phone <span style="font-weight:400;color:var(--stone)">(optional)</span></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" /></div>
					<div class="field"><label for="message">How can we help?</label><textarea id="message" name="message" required minlength="10" maxlength="4000" placeholder="Share what you are looking for, or simply say hello."></textarea></div>
					<div class="field" style="position:absolute;left:-10000px" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
					<button class="button" type="submit">Send your message <span aria-hidden="true">↗</span></button>
				</form>
				{(businessDetails.email || businessDetails.phone || businessDetails.address || businessDetails.serviceArea) && <aside class="business-details"><span class="eyebrow">Estate &amp; Estate</span><h2 class="serif">Here to help.</h2>
					{businessDetails.email && <p><span>Email</span><a href={`mailto:${businessDetails.email}`}>{businessDetails.email}</a></p>}
					{businessDetails.phone && <p><span>Phone</span><a href={`tel:${businessDetails.phone.replace(/[^+\d]/g, '')}`}>{businessDetails.phone}</a></p>}
					{businessDetails.address && <p><span>Office</span>{businessDetails.address}</p>}
					{businessDetails.serviceArea && <p><span>Areas we serve</span>{businessDetails.serviceArea}</p>}
				</aside>}</div>
			</>}
		</div></section>
	</main>
	<footer class="site-footer"><div class="wrap footer-bottom"><a href="/">Estate &amp; Estate</a><span>© {new Date().getFullYear()} Estate &amp; Estate</span><a href="/properties">Properties</a></div></footer>
	<script>
		const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle'); const nav = document.querySelector<HTMLElement>('.main-nav');
		toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation'); nav?.classList.toggle('open', open); });
	</script>
</Layout>
